{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 38,
  "version": 1,
  "title": "DevIA - Monitoring APIs Ferroviaires",
  "tags": ["devia", "fastapi", "prometheus"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, job)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Statut des services (UP)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [ {"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}} ], "thresholds": { "steps": [ {"color":"red","value":null}, {"color":"green","value":1} ] } } },
      "targets": [ { "expr": "up{job=~\"api_data|api_ia\"}", "legendFormat": "{{job}}" } ]
    },
    {
      "type": "stat",
      "title": "Requetes / s (total)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": {"mode":"thresholds"}, "thresholds": { "steps": [ {"color":"blue","value":null} ] } } },
      "targets": [ { "expr": "sum(rate(http_requests_total[1m]))" } ]
    },
    {
      "type": "stat",
      "title": "Taux d'erreurs 5xx (%)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [ {"color":"green","value":null}, {"color":"orange","value":1}, {"color":"red","value":5} ] } } },
      "targets": [ { "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])),1)" } ]
    },
    {
      "type": "stat",
      "title": "Latence p95 (s)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [ {"color":"green","value":null}, {"color":"orange","value":0.3}, {"color":"red","value":1} ] } } },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))" } ]
    },
    {
      "type": "timeseries",
      "title": "Debit par service (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } } },
      "targets": [ { "expr": "sum(rate(http_requests_total[1m])) by (job)", "legendFormat": "{{job}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Latence des requetes (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Codes de reponse HTTP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": {"mode":"normal"} } } },
      "targets": [ { "expr": "sum(rate(http_requests_total[1m])) by (status)", "legendFormat": "{{status}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Top endpoints par trafic",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [ { "expr": "topk(5, sum(rate(http_requests_total[5m])) by (handler))", "legendFormat": "{{handler}}" } ]
    }
  ]
}
