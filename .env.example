# Copier ce fichier en .env (cp .env.example .env) puis l'adapter.
# Le fichier .env n'est pas versionne : ne jamais y committer de secret.

# --- API DATA ---
API_DATA_HOST=0.0.0.0
API_DATA_PORT=8001

# --- API IA ---
API_IA_HOST=0.0.0.0
API_IA_PORT=8000
# Pour docker compose, decommenter (nom du service Docker) ;
# en local, laisser commente : Streamlit utilise http://localhost:API_IA_PORT/predict
# API_IA_URL=http://api_ia:8000/predict

# --- STREAMLIT ---
STREAMLIT_PORT=8501

# --- DATABASE ---
DB_URL=sqlite:///./data/events.db

# --- PATHS ---
CSV_EVENTS_PATH=./data/evenements_1500.csv
MODEL_PATH=./models/model.joblib

# --- SECURITY ---
API_SECRET_KEY=change_me
